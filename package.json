{
  "name": "orbitssh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OrbitSSH is a Chinese-language local desktop SSH workbench with MCP tools for local AI clients.",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run rebuild:electron",
    "dev": "electron-vite dev",
    "build:code": "tsc --noEmit && electron-vite build && tsup src/mcp/server.ts --format esm --platform node --target node22 --out-dir dist/mcp --external @modelcontextprotocol/sdk --external zod && tsup src/runtime/host-entry.ts --format esm --platform node --target node22 --out-dir dist/runtime --external @napi-rs/keyring --external better-sqlite3 --external better-sqlite3-electron --external ssh2 --external zod",
    "build": "npm run rebuild:electron && npm run build:code && npm run verify:sqlite-abis",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:sqlite": "tsx --test tests/sqlite-store.test.ts",
    "rebuild:electron": "node scripts/rebuild-electron-sqlite.mjs",
    "test:node-sqlite": "node --import tsx scripts/node-sqlite-smoke.ts",
    "test:electron-sqlite": "set \"ELECTRON_RUN_AS_NODE=1\"&& electron --import tsx scripts/electron-sqlite-smoke.ts",
    "verify:sqlite-abis": "npm run test:node-sqlite && npm run test:electron-sqlite && npm run test:node-sqlite",
    "build:windows": "npm run build",
    "test:policy": "tsx --test tests/command-policy.test.ts",
    "lint": "tsc --noEmit",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@napi-rs/keyring": "^1.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.8.1",
    "better-sqlite3-electron": "npm:better-sqlite3@^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shell-quote": "1.10.0",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
