{
  "name": "ai-ssh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chinese-language local desktop SSH workbench with MCP tools for local AI clients.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build && tsup src/mcp/server.ts --format esm --platform node --target node22 --out-dir dist/mcp --external @napi-rs/keyring --external ssh2 --external @modelcontextprotocol/sdk --external zod",
    "typecheck": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "test:policy": "tsx --test tests/command-policy.test.ts",
    "lint": "tsc --noEmit",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@napi-rs/keyring": "^1.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shell-quote": "1.10.0",
    "ssh2": "^1.16.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
